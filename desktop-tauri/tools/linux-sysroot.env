# Source this before cargo check/build AND before running the Tauri binary on
# a Linux box without system webkit2gtk (see tools/linux-sysroot.sh).
SYSROOT="${TAURI_SYSROOT:-$HOME/.tauri-sysroot}"
ROOT="$SYSROOT/root"
export PKG_CONFIG_SYSROOT_DIR="$ROOT"
export PKG_CONFIG_PATH="$ROOT/usr/lib/x86_64-linux-gnu/pkgconfig:$ROOT/usr/share/pkgconfig:$ROOT/usr/lib/pkgconfig"
# link + runtime lookup into the sysroot
export LIBRARY_PATH="$ROOT/usr/lib/x86_64-linux-gnu:$ROOT/usr/lib"
export LD_LIBRARY_PATH="$ROOT/usr/lib/x86_64-linux-gnu:$ROOT/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export RUSTFLAGS="-L $ROOT/usr/lib/x86_64-linux-gnu ${RUSTFLAGS:-}"
# glib compile-time helpers (glib-mkenums etc. used by some -sys build scripts)
export PATH="$ROOT/usr/bin:$PATH"

# --- runtime-only (verified needed on WSL2/WSLg, Ubuntu 26.04) ---
# glib schemas from the sysroot (app would abort on missing schemas)
export GSETTINGS_SCHEMA_DIR="$ROOT/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$ROOT/usr/share:${XDG_DATA_DIRS:-/usr/share}"
# WSL: bubblewrap sandbox and dmabuf GPU paths don't survive here; software
# rendering is used instead (libEGL warnings are expected and harmless)
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
